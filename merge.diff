+                 export const ok: Foo = { a: 1, b: 's', c: true };\n\
+                 export const missing: Foo = { a: 1, b: 's' };\n\
+                 export const wrong: Foo = { a: 1, b: 2, c: true };\n",
+            ),
+        ],
