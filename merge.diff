+}
+
+const BASE: &str = "export interface Foo { a: number }\nexport const k = 1;\n";
+const AUG_B: &str = "import './a';\ndeclare module './a' { interface Foo { b: string } }\n";
+const AUG_C: &str = "import './a';\ndeclare module './a' { interface Foo { c: boolean } }\n";
