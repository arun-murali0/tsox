target
dhat-heap.json
.harness/
cfg_dump.txt
node_modules
# The module resolution fixtures are packages on disk by design.
!tests/module-resolution-fixtures/**/node_modules
!tests/module-resolution-fixtures/**/node_modules/**

# wasm-pack build output (see pkg-template/ for the shipped package.json)
/pkg/
/pkg-*/

# editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS noise
.DS_Store
Thumbs.db

# local secrets — never commit these (CI's hygiene job also rejects them)
.env
.env.local
.env.production

# profiling / flamegraph output
*.pdb
perf.data
perf.data.old
flamegraph.svg

# tsc result cache (see scripts/ts-diag-tool/check-fixtures.js)
scripts/ts-diag-tool/.tsc-cache.json

# tsgo copy installed by compare-local.sh --tsgo
scripts/ts-diag-tool/.tsgo/

# npm package build output (scripts/build-wasm.sh)
/npm/tsox/node/
/npm/tsox/web/
/npm/tsox/LICENSE-*

# VitePress
/docs/.vitepress/dist/
/docs/.vitepress/cache/

# Local secrets (see .env.development.example)
.env.development
.env.*.local

# The corpus is fetched here by scripts/corpus.py
/.corpus/
