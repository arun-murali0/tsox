#!/usr/bin/env bash
set -euo pipefail

# Runs locally on `git push` (enable once with: bash scripts/enable-hooks.sh).
# Same checks as the branch gate in CI (scripts/ci.sh): formatting and tests.
# The tsc comparison is not run here; CI runs it once per merge on merge-tmp/*.

if ! cargo fmt --all -- --check; then
  echo
  echo "Formatting is off. Run 'cargo fmt --all', commit the result, then push again."
  exit 1
fi

cargo test --locked --workspace --all-features
